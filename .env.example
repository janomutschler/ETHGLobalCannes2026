# LLM (pick one path)
# — OpenAI (default): set OPENAI_API_KEY below and leave GEMINI_API_KEY empty.
# — Gemini: set GEMINI_API_KEY (it overrides; OpenAI vars are ignored for the model client).
# — If OPENAI_API_KEY starts with AIza… it is treated as a Google key and uses the Gemini SDK.
# Do not set OPENAI_BASE_URL to generativelanguage.googleapis.com — not OpenAI-compatible (404).

# OpenAI (https://platform.openai.com/api-keys) — use sk-… key (never commit real keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Official API — base URL optional (SDK defaults to https://api.openai.com/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (https://aistudio.google.com/apikey) — leave empty to use OpenAI above
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta

# Groq (OpenAI-compatible; agent defaults model to llama-3.3-70b-versatile when BASE_URL is Groq)
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# OpenRouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemma-2-9b-it:free

# 0G Storage SDK (optional — merged into agent tools when npm deps are installed)
# Defaults: testnet indexer + EVM RPC below. Downloads + local root-hash work without a key.
# STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
# STORAGE_EVM_RPC=https://evmrpc-testnet.0g.ai
# STORAGE_PRIVATE_KEY=0x...   # only for storage_upload_text (gas). Else use ZEROG_PRIVATE_KEY.

# Passed through to the 0G MCP child process (optional)
# ZEROG_NETWORK=testnet
# ZEROG_PRIVATE_KEY=0x...   # enables 0G broker (without it, server warns and some tools may be limited)
# OPENROUTER_API_KEY=

# Optional: use globally installed CLI instead of npx
# ZERO_G_MCP_COMMAND=0g-cc
# ZERO_G_MCP_ARGS=[]

# Web UI (npm run ui)
# UI_PORT=3847
# UI_HOST=127.0.0.1
# UI_HOST=0.0.0.0   # listen on all interfaces (LAN / Docker)

# Before first run: npm run preflight

# OpenClaw: install plugins/openclaw-0g, run npm run ui, set base URL for zerog_agent_chat
# OG_AGENT_BASE_URL=http://127.0.0.1:3847

# Digital twin RAG (memory/rag-store.json) — needs OpenAI sk-… or Gemini key for embeddings
# Groq-only LLM: set OPENAI_API_KEY for embeddings or GEMINI_API_KEY, or RAG_EMBEDDING_PROVIDER=openai|gemini
# RAG_DISABLED=1
# RAG_EMBEDDING_PROVIDER=auto
# RAG_CHUNK_SIZE=600
# RAG_CHUNK_OVERLAP=80
# RAG_TOP_K=5
# RAG_MAX_CHUNKS=1500
# RAG_OPENAI_EMBED_MODEL=text-embedding-3-small
# RAG_GEMINI_EMBED_MODEL=text-embedding-004

# File memory (memory/short-term.txt + long-term.txt), or 0G blobs + memory/zerog-roots.json
# Start a message with: !remember your important fact
# MEMORY_BACKEND=zerog   # or 0g — reads use indexer; writes need STORAGE_PRIVATE_KEY or ZEROG_PRIVATE_KEY
# MEMORY_ZEROG_MAX_DOWNLOAD=512000   # max UTF-8 chars to pull per blob from 0G
# MEMORY_SHORT_MAX_CHARS=8000
# MEMORY_LONG_MAX_CHARS=6000
# MEMORY_LONG_MAX_ENTRIES=32   # max !remember facts kept (oldest dropped first)
# MEMORY_SHORT_MAX_BLOCKS=12
# MEMORY_DIR=/absolute/custom/path

# Agent personality (markdown). Default: ./soul.md next to agent-core.mjs
# SOUL_PATH=/absolute/path/to/soul.md
